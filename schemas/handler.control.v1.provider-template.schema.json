{
  "$id": "urn:handler.control/v1/provider-template",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EnvSecret": {
      "additionalProperties": false,
      "properties": {
        "env": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvSecret",
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "FileSecret": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "FileSecret",
      "type": "object"
    },
    "ProviderModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "contextWindow": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contextwindow"
        },
        "maxOutput": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxoutput"
        },
        "reasoning": {
          "default": false,
          "title": "Reasoning",
          "type": "boolean"
        },
        "images": {
          "default": false,
          "title": "Images",
          "type": "boolean"
        },
        "speech": {
          "default": false,
          "title": "Speech",
          "type": "boolean"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "native": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProviderModel",
      "type": "object"
    }
  },
  "description": "A starting point for a provider (templates/providers/, D.12). A local server's has no\nmodel: they are picked from what it serves (`POST /v1/providers/test`).",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "endpoints": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "anthropic",
          "openai-chat",
          "responses",
          "transcriptions"
        ]
      },
      "title": "Endpoints",
      "type": "object"
    },
    "models": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderModel"
      },
      "title": "Models",
      "type": "array"
    },
    "needsKey": {
      "default": false,
      "title": "Needskey",
      "type": "boolean"
    },
    "files": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FileSecret"
                },
                {
                  "$ref": "#/$defs/EnvSecret"
                },
                {
                  "$ref": "#/$defs/FileContent"
                }
              ]
            },
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Files"
    }
  },
  "required": [
    "name",
    "endpoints"
  ],
  "title": "ProviderTemplate",
  "type": "object"
}
