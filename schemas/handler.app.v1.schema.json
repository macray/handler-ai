{
  "$id": "urn:handler.app/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AppManifestAction": {
      "additionalProperties": false,
      "description": "An action: something the person can ask the app in a sentence (H.12), what Ask's router\nreads, what the app's page lists (with Try). Done by its code (`route`: the backend answers an\nActionResult at once) or by one of its jobs (`job`: a run of it, its form the job's).",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "examples": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Examples",
          "type": "array"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "job": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        }
      },
      "required": [
        "description"
      ],
      "title": "AppManifestAction",
      "type": "object"
    },
    "AppManifestFileNeed": {
      "additionalProperties": false,
      "description": "A folder (or a file) of the person's the backend reads (or writes), H.9: which one is the\nperson's choice at install, mounted at the same path.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "mode": {
          "default": "ro",
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        },
        "init": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Init",
          "type": "array"
        }
      },
      "title": "AppManifestFileNeed",
      "type": "object"
    },
    "AppManifestJob": {
      "additionalProperties": false,
      "description": "A job (H.1): work of the app's that needs a model, run by the Who works the person chose\nfor the app. Its instructions are `jobs/<name>.md` of the app's folder; what it reaches (its\nfolders and their access, its schemas, its hosts) is declared here, said before a deploy that\nadds to it.",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "files": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "enum": [
                "read",
                "write"
              ],
              "type": "string"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "worksIn": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,29}$",
            "type": "string"
          },
          "title": "Worksin",
          "type": "array"
        },
        "schemas": {
          "default": [],
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Schemas",
          "type": "array"
        },
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "timeout": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d{0,3}[mhd]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "then": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Then"
        }
      },
      "required": [
        "description",
        "result"
      ],
      "title": "AppManifestJob",
      "type": "object"
    },
    "AppManifestNeeds": {
      "additionalProperties": false,
      "description": "What the app may reach (H.2). Shown when it is deployed; more than before is flagged.",
      "properties": {
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "files": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestFileNeed"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "notify": {
          "default": false,
          "title": "Notify",
          "type": "boolean"
        }
      },
      "title": "AppManifestNeeds",
      "type": "object"
    },
    "AppManifestNudge": {
      "additionalProperties": false,
      "description": "A nudge (H.17): something the app asks a person to do, under a name that stays the same\nfrom one to the next (`daily-log`). A click opens one of its actions' form (`action`) or a\npage of its UI (`open`): the manifest's, never the call's.",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "open": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^/[A-Za-z0-9/_.~%-]*(\\?[A-Za-z0-9=&_.~%-]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open"
        },
        "remind": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppManifestNudgeRemind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ifIgnored": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ifignored"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Schedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prepare": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prepare"
        },
        "until": {
          "anyOf": [
            {
              "const": "next",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "description"
      ],
      "title": "AppManifestNudge",
      "type": "object"
    },
    "AppManifestNudgeRemind": {
      "additionalProperties": false,
      "description": "How often an open nudge alerts again, by default (the person tones it per nudge, H.17):\nevery `every`, `times` times after its first alert.",
      "properties": {
        "every": {
          "pattern": "^[1-9]\\d{0,3}[mhd]$",
          "title": "Every",
          "type": "string"
        },
        "times": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Times",
          "type": "integer"
        }
      },
      "required": [
        "every"
      ],
      "title": "AppManifestNudgeRemind",
      "type": "object"
    },
    "AppManifestServer": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "default": "server/main.ts",
          "title": "Entry",
          "type": "string"
        }
      },
      "title": "AppManifestServer",
      "type": "object"
    },
    "AppManifestSuggestedAutomation": {
      "additionalProperties": false,
      "description": "An automation the app suggests (`[[automations]]`, I.1): installed with the app, made and\nturned on at Install unless the person switches it off there (`optional`: off unless they\nswitch it on; the CLI asks for each); later made from the app's page, off; its results open\nthe app.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/Schedule"
        },
        "run": {
          "$ref": "#/$defs/AppManifestSuggestedRun"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "when",
        "run"
      ],
      "title": "AppManifestSuggestedAutomation",
      "type": "object"
    },
    "AppManifestSuggestedRun": {
      "additionalProperties": false,
      "description": "What a suggested automation runs: one of the app's jobs (`job`, with its `input`), or one\nof its routes (`call`, as a person's automation calls it: `run = { app, call }`, I.3).",
      "properties": {
        "job": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job"
        },
        "input": {
          "$ref": "#/$defs/AutomationAgentInput",
          "default": {
            "fields": {}
          }
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        }
      },
      "title": "AppManifestSuggestedRun",
      "type": "object"
    },
    "AppManifestUi": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "default": "ui/dist",
          "title": "Dir",
          "type": "string"
        }
      },
      "title": "AppManifestUi",
      "type": "object"
    },
    "AutomationAgentInput": {
      "additionalProperties": false,
      "description": "What the agent's run is started with (D.18 `SessionInput`).",
      "properties": {
        "fields": {
          "additionalProperties": true,
          "default": {},
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "AutomationAgentInput",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "memory": {
          "anyOf": [
            {
              "pattern": "^\\d+[kmgKMG]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "description": "A `when` that is a time (I.2): every N minutes, hours or days, or at a local time of day.",
      "properties": {
        "every": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d{0,3}[mhd]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every"
        },
        "at": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "days": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        }
      },
      "title": "Schedule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "handler.app/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{0,29}$",
      "title": "Name",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "changes": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Changes"
    },
    "server": {
      "$ref": "#/$defs/AppManifestServer",
      "default": {
        "entry": "server/main.ts"
      }
    },
    "ui": {
      "$ref": "#/$defs/AppManifestUi",
      "default": {
        "dir": "ui/dist"
      }
    },
    "needs": {
      "$ref": "#/$defs/AppManifestNeeds",
      "default": {
        "egress": [],
        "secrets": [],
        "files": {},
        "notify": false
      }
    },
    "routes": {
      "default": {},
      "patternProperties": {
        "^(POST|PUT|PATCH|DELETE) /api/[A-Za-z0-9/_.-]*$": {
          "enum": [
            "sync",
            "queued"
          ],
          "type": "string"
        }
      },
      "title": "Routes",
      "type": "object"
    },
    "automations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppManifestSuggestedAutomation"
      },
      "maxItems": 5,
      "title": "Automations",
      "type": "array"
    },
    "actions": {
      "default": {},
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,29}$": {
          "$ref": "#/$defs/AppManifestAction"
        }
      },
      "title": "Actions",
      "type": "object"
    },
    "jobs": {
      "default": {},
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,29}$": {
          "$ref": "#/$defs/AppManifestJob"
        }
      },
      "title": "Jobs",
      "type": "object"
    },
    "nudges": {
      "default": {},
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,29}$": {
          "$ref": "#/$defs/AppManifestNudge"
        }
      },
      "title": "Nudges",
      "type": "object"
    },
    "resources": {
      "anyOf": [
        {
          "$ref": "#/$defs/Resources"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schemas": {
      "default": [],
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Schemas",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "name",
    "version"
  ],
  "title": "AppManifest",
  "type": "object"
}
