{
  "$id": "urn:handler.app/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AppManifestAction": {
      "additionalProperties": false,
      "description": "An action: something the person can ask the app in a sentence (H.12), what Ask's router\nreads, what the app's page lists (with Try). Done by its code (`route`: the backend answers an\nActionResult at once) or by one of its agents (`agent`: a run of the agent given for that need,\nits form filled with the action's fields).",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "examples": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Examples",
          "type": "array"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "agent": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        }
      },
      "required": [
        "description"
      ],
      "title": "AppManifestAction",
      "type": "object"
    },
    "AppManifestAgentNeed": {
      "additionalProperties": false,
      "description": "A job the app starts runs of (H.11): which agent is the person's choice at install, one of\ntheirs that fits or one set up from the definition the app ships.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "worksIn": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worksin"
        }
      },
      "required": [
        "from"
      ],
      "title": "AppManifestAgentNeed",
      "type": "object"
    },
    "AppManifestFileNeed": {
      "additionalProperties": false,
      "description": "A folder (or a file) of the person's the backend reads (or writes), H.9: which one is the\nperson's choice at install, mounted at the same path.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "mode": {
          "default": "ro",
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        },
        "init": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Init",
          "type": "array"
        }
      },
      "title": "AppManifestFileNeed",
      "type": "object"
    },
    "AppManifestNeeds": {
      "additionalProperties": false,
      "description": "What the app may reach (H.2). Shown when it is deployed; more than before is flagged.",
      "properties": {
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "files": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestFileNeed"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "notify": {
          "default": false,
          "title": "Notify",
          "type": "boolean"
        },
        "agents": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestAgentNeed"
            }
          },
          "title": "Agents",
          "type": "object"
        }
      },
      "title": "AppManifestNeeds",
      "type": "object"
    },
    "AppManifestServer": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "default": "server/main.ts",
          "title": "Entry",
          "type": "string"
        }
      },
      "title": "AppManifestServer",
      "type": "object"
    },
    "AppManifestSuggestedAutomation": {
      "additionalProperties": false,
      "description": "An automation the app suggests (`[[automations]]`, I.1): made by the person from the app's\npage, off until they turn it on; its results open the app.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/Schedule"
        },
        "run": {
          "$ref": "#/$defs/AppManifestSuggestedRun"
        }
      },
      "required": [
        "description",
        "when",
        "run"
      ],
      "title": "AppManifestSuggestedAutomation",
      "type": "object"
    },
    "AppManifestSuggestedRun": {
      "additionalProperties": false,
      "description": "What a suggested automation runs: the agent given for one of the app's needs.",
      "properties": {
        "agent": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "Agent",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/AutomationAgentInput",
          "default": {
            "fields": {}
          }
        }
      },
      "required": [
        "agent"
      ],
      "title": "AppManifestSuggestedRun",
      "type": "object"
    },
    "AppManifestUi": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "default": "ui/dist",
          "title": "Dir",
          "type": "string"
        }
      },
      "title": "AppManifestUi",
      "type": "object"
    },
    "AutomationAgentInput": {
      "additionalProperties": false,
      "description": "What the agent's run is started with (D.18 `SessionInput`).",
      "properties": {
        "fields": {
          "additionalProperties": true,
          "default": {},
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "AutomationAgentInput",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "memory": {
          "anyOf": [
            {
              "pattern": "^\\d+[kmgKMG]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "description": "A `when` that is a time (I.2): every N minutes or hours, or at a local time of day.",
      "properties": {
        "every": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d{0,3}[mh]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every"
        },
        "at": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "days": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        }
      },
      "title": "Schedule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "handler.app/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{0,29}$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "server": {
      "$ref": "#/$defs/AppManifestServer",
      "default": {
        "entry": "server/main.ts"
      }
    },
    "ui": {
      "$ref": "#/$defs/AppManifestUi",
      "default": {
        "dir": "ui/dist"
      }
    },
    "needs": {
      "$ref": "#/$defs/AppManifestNeeds",
      "default": {
        "egress": [],
        "secrets": [],
        "files": {},
        "notify": false,
        "agents": {}
      }
    },
    "routes": {
      "default": {},
      "patternProperties": {
        "^(POST|PUT|PATCH|DELETE) /api/[A-Za-z0-9/_.-]*$": {
          "enum": [
            "sync",
            "queued"
          ],
          "type": "string"
        }
      },
      "title": "Routes",
      "type": "object"
    },
    "automations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppManifestSuggestedAutomation"
      },
      "maxItems": 5,
      "title": "Automations",
      "type": "array"
    },
    "actions": {
      "default": {},
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,29}$": {
          "$ref": "#/$defs/AppManifestAction"
        }
      },
      "title": "Actions",
      "type": "object"
    },
    "resources": {
      "anyOf": [
        {
          "$ref": "#/$defs/Resources"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "apiVersion",
    "name",
    "version"
  ],
  "title": "AppManifest",
  "type": "object"
}
