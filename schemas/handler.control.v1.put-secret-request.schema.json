{
  "$id": "urn:handler.control/v1/put-secret-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Set a secret's value and description (replacing them).",
  "properties": {
    "value": {
      "maxLength": 16384,
      "minLength": 1,
      "pattern": "^[^\\n\\r]*$",
      "title": "Value",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    }
  },
  "required": [
    "value"
  ],
  "title": "PutSecretRequest",
  "type": "object"
}
