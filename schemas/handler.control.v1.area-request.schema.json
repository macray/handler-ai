{
  "$id": "urn:handler.control/v1/area-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Create an area, or change its colour (PUT: the name is the path's).",
  "properties": {
    "name": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9 _-]*[A-Za-z0-9])?$",
      "title": "Name",
      "type": "string"
    },
    "color": {
      "enum": [
        "blue",
        "violet",
        "cyan",
        "pink",
        "slate"
      ],
      "title": "Color",
      "type": "string"
    }
  },
  "required": [
    "name",
    "color"
  ],
  "title": "AreaRequest",
  "type": "object"
}
