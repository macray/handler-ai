{
  "$id": "urn:handler.control/v1/addon-catalog-entry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An addon handler ships but does not load until it is installed (G.5).",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "installed": {
      "default": false,
      "title": "Installed",
      "type": "boolean"
    }
  },
  "required": [
    "name"
  ],
  "title": "AddonCatalogEntry",
  "type": "object"
}
