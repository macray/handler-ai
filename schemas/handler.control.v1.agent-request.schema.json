{
  "$id": "urn:handler.control/v1/agent-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddonUse": {
      "description": "An addon an agent or a project uses (G.3): by its name, with the binding filling its\nslots when it has some (G.2); one without slots has no binding.",
      "properties": {
        "addon": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Addon",
          "type": "string"
        },
        "binding": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding"
        }
      },
      "required": [
        "addon"
      ],
      "title": "AddonUse",
      "type": "object"
    },
    "AgentInterface": {
      "description": "How a session of an agent starts and ends (D.18): a form (one of its fields may name a\nskill of the library to work on, its subject), and maybe the result its final message holds.\nWith a result, a job: each run is unattended, so in permission mode `bypass` (no one is there\nto answer its requests). Without, a brief: the form starts a session you then work in.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "timeoutSec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 86400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutsec"
        }
      },
      "title": "AgentInterface",
      "type": "object"
    },
    "AgentOrigin": {
      "description": "What an agent was set up from, kept for good: the definition of an app's need (H.2), an\nagents file's agent (D.23), or the definition of one of Handler's needs (D.18). Only what it\ncame from: where the agent lives is its home (`projectId`, `app`, `chat`).",
      "properties": {
        "kind": {
          "enum": [
            "app",
            "agents-file",
            "handler-need"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "AgentOrigin",
      "type": "object"
    },
    "ModelAccess": {
      "description": "What an agent runs as (E): a harness and the account or the provider its model calls use\n(exactly one), and the model. An agent has one (D.1); a session runs with it or another picked\nfor that session (D.19). An agent on the model alone (D.18) has no harness: a provider only\n(AgentSettings checks it).",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "account": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "ModelAccess",
      "type": "object"
    }
  },
  "description": "An agent: the body of create (POST) and of a full update (PUT). Its home is one of: a\nproject (`projectId`: it works in the project's folder), an app (`app`: one of its parts,\nH.14), Chat (`chat`: someone you talk to, with no folder), or none (outside projects, in its\nown folder or a folder per session). The home is given at creation and never changes.",
  "properties": {
    "model": {
      "$ref": "#/$defs/ModelAccess"
    },
    "network": {
      "default": "filtered",
      "enum": [
        "none",
        "filtered",
        "open"
      ],
      "title": "Network",
      "type": "string"
    },
    "egress": {
      "default": "enforce",
      "enum": [
        "enforce",
        "log-only"
      ],
      "title": "Egress",
      "type": "string"
    },
    "allow": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allow",
      "type": "array"
    },
    "blocked": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blocked",
      "type": "array"
    },
    "confinement": {
      "default": "strict",
      "enum": [
        "strict",
        "nested",
        "privileged"
      ],
      "title": "Confinement",
      "type": "string"
    },
    "permissions": {
      "default": "bypass",
      "enum": [
        "ask",
        "accept-edits",
        "bypass"
      ],
      "title": "Permissions",
      "type": "string"
    },
    "addons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AddonUse"
      },
      "title": "Addons",
      "type": "array"
    },
    "knowledge": {
      "default": [],
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^[^/\\x00]",
        "type": "string"
      },
      "title": "Knowledge",
      "type": "array"
    },
    "display": {
      "default": false,
      "title": "Display",
      "type": "boolean"
    },
    "interface": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentInterface"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modelAlone": {
      "default": false,
      "title": "Modelalone",
      "type": "boolean"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectid"
    },
    "app": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "App"
    },
    "chat": {
      "default": false,
      "title": "Chat",
      "type": "boolean"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "instructions": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instructions"
    },
    "skills": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "default": {
      "type": "boolean",
      "default": false,
      "title": "Default"
    },
    "remoteStart": {
      "default": false,
      "title": "Remotestart",
      "type": "boolean"
    },
    "confirmRisks": {
      "default": false,
      "title": "Confirmrisks",
      "type": "boolean"
    },
    "toolboxAdds": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Toolboxadds",
      "type": "array"
    }
  },
  "required": [
    "model"
  ],
  "title": "AgentRequest",
  "type": "object"
}
