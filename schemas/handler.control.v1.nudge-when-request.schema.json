{
  "$id": "urn:handler.control/v1/nudge-when-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Schedule": {
      "additionalProperties": false,
      "description": "A `when` that is a time (I.2): every N minutes, hours or days, or at a local time of day.",
      "properties": {
        "every": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d{0,3}[mhd]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every"
        },
        "at": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "days": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        }
      },
      "title": "Schedule",
      "type": "object"
    }
  },
  "description": "`PUT /v1/apps/{name}/nudges/{nudge}/when`: when handlerd sends that nudge (H.17), yours\nreplacing the app's; null: as the app says.",
  "properties": {
    "when": {
      "anyOf": [
        {
          "$ref": "#/$defs/Schedule"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "when"
  ],
  "title": "NudgeWhenRequest",
  "type": "object"
}
