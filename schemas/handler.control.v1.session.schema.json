{
  "$id": "urn:handler.control/v1/session",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SessionAppDraft": {
      "description": "A session working on a draft of an app's code (H.15): its folder, kept by Handler, starts\nas a copy of `app`'s code, or empty for a new app (none). Used (`POST\n/v1/apps/from-draft/{session}`), its code becomes the app's next version, or a new app.",
      "properties": {
        "app": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App"
        }
      },
      "title": "SessionAppDraft",
      "type": "object"
    },
    "SessionInput": {
      "description": "What a session of an agent with an interface is started with (D.18): a job's run, a\nbrief's session.",
      "properties": {
        "fields": {
          "additionalProperties": true,
          "default": {},
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "SessionInput",
      "type": "object"
    },
    "SessionOutput": {
      "description": "A run's result (D.18), taken from its final message once its turn ended.",
      "properties": {
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "valid"
      ],
      "title": "SessionOutput",
      "type": "object"
    },
    "SessionPlan": {
      "description": "The plan a session is a step of (origin \"plan\", D.27).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "step"
      ],
      "title": "SessionPlan",
      "type": "object"
    },
    "SessionPlanDraft": {
      "description": "The plan draft a plan builder's session writes (D.27): its folder is the draft, its\nproject's folder seen read-only, at its own path.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "folder": {
          "title": "Folder",
          "type": "string"
        }
      },
      "required": [
        "id",
        "projectId",
        "folder"
      ],
      "title": "SessionPlanDraft",
      "type": "object"
    },
    "SessionSubject": {
      "description": "What a run works on (D.18): the skill its form's skill field named, as it saw it.",
      "properties": {
        "skill": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Skill",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "skill",
        "digest"
      ],
      "title": "SessionSubject",
      "type": "object"
    }
  },
  "description": "A daemon-held chat session (F.1): one sandbox, outliving the clients attached to it.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "agentId": {
      "title": "Agentid",
      "type": "string"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectid"
    },
    "harness": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Harness"
    },
    "account": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "acpSessionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acpsessionid"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "stopped",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "busy": {
      "default": false,
      "title": "Busy",
      "type": "boolean"
    },
    "pendingPermissions": {
      "default": 0,
      "title": "Pendingpermissions",
      "type": "integer"
    },
    "attached": {
      "default": 0,
      "title": "Attached",
      "type": "integer"
    },
    "remote": {
      "default": false,
      "title": "Remote",
      "type": "boolean"
    },
    "canResume": {
      "default": false,
      "title": "Canresume",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "missingImage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missingimage"
    },
    "request": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request"
    },
    "harnessVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harnessversion"
    },
    "origin": {
      "default": "ui",
      "enum": [
        "ui",
        "cli",
        "editor",
        "phone",
        "automation",
        "app",
        "check",
        "ask",
        "plan"
      ],
      "title": "Origin",
      "type": "string"
    },
    "app": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "App"
    },
    "waitingFor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waitingfor"
    },
    "lastStopReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Laststopreason"
    },
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unattended": {
      "default": false,
      "title": "Unattended",
      "type": "boolean"
    },
    "subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionSubject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "appDraft": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionAppDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planDraft": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionPlanDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "lastActivityAt": {
      "format": "date-time",
      "title": "Lastactivityat",
      "type": "string"
    },
    "acpUrl": {
      "title": "Acpurl",
      "type": "string"
    }
  },
  "required": [
    "id",
    "agentId",
    "harness",
    "scope",
    "state",
    "createdAt",
    "lastActivityAt",
    "acpUrl"
  ],
  "title": "Session",
  "type": "object"
}
