{
  "$id": "urn:handler.control/v1/project",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Agent": {
      "description": "What sessions are opened on: a harness on an account or a provider (what, its model)\nworking in a folder (where), with its settings. Its home: a project (`projectId`: its\nsettings all its own; its folder, caches and skills its project's), an app (`app`: one of its\nparts), Chat (`chat`: someone you talk to), or none (outside projects: made on the Other\nfolders page, or by `handler run`, `handler acp` and `handler terminal`).",
      "properties": {
        "model": {
          "$ref": "#/$defs/AgentModel"
        },
        "network": {
          "enum": [
            "none",
            "filtered",
            "open"
          ],
          "title": "Network",
          "type": "string"
        },
        "egress": {
          "anyOf": [
            {
              "enum": [
                "enforce",
                "log-only"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egress"
        },
        "allow": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "confinement": {
          "enum": [
            "strict",
            "nested",
            "privileged"
          ],
          "title": "Confinement",
          "type": "string"
        },
        "permissions": {
          "enum": [
            "ask",
            "accept-edits",
            "bypass"
          ],
          "title": "Permissions",
          "type": "string"
        },
        "bindings": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Bindings",
          "type": "array"
        },
        "knowledge": {
          "default": [],
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[^/\\x00]",
            "type": "string"
          },
          "title": "Knowledge",
          "type": "array"
        },
        "display": {
          "default": false,
          "title": "Display",
          "type": "boolean"
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentInterface"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modelAlone": {
          "default": false,
          "title": "Modelalone",
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projectid"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "app": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App"
        },
        "chat": {
          "default": false,
          "title": "Chat",
          "type": "boolean"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remoteStart": {
          "default": false,
          "title": "Remotestart",
          "type": "boolean"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "projectSkills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Projectskills",
          "type": "array"
        },
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area"
        },
        "acpUrl": {
          "title": "Acpurl",
          "type": "string"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "title": "Connections",
          "type": "array"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "lastUsedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastusedat"
        }
      },
      "required": [
        "model",
        "network",
        "confinement",
        "permissions",
        "id",
        "acpUrl",
        "connections",
        "createdAt"
      ],
      "title": "Agent",
      "type": "object"
    },
    "AgentInterface": {
      "description": "How a session of an agent starts and ends (D.18): a form (one of its fields may name a\nskill of the library to work on, its subject), and maybe the result its final message holds.\nWith a result, a job: each run is unattended, so in permission mode `bypass` (no one is there\nto answer its requests). Without, a brief: the form starts a session you then work in.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "timeoutSec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 86400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutsec"
        }
      },
      "title": "AgentInterface",
      "type": "object"
    },
    "AgentModel": {
      "description": "An agent's model (D.1): its harness resolved, and what it needs now.",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Harness"
        },
        "account": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem"
        },
        "requiredHosts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RequiredHost"
          },
          "title": "Requiredhosts",
          "type": "array"
        }
      },
      "required": [
        "harness"
      ],
      "title": "AgentModel",
      "type": "object"
    },
    "AgentOrigin": {
      "description": "What an agent was set up from, kept for good: the definition of an app's need (H.2), an\nagents file's agent (D.23), or the definition of one of Handler's needs (D.18). Only what it\ncame from: where the agent lives is its home (`projectId`, `app`, `chat`).",
      "properties": {
        "kind": {
          "enum": [
            "app",
            "agents-file",
            "handler-need"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "AgentOrigin",
      "type": "object"
    },
    "Connection": {
      "description": "One of an agent's running sandboxes: a plain connection (C), a session's (F) or a\nterminal's (D.16).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sandbox": {
          "title": "Sandbox",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelAccess"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "sandbox",
        "since"
      ],
      "title": "Connection",
      "type": "object"
    },
    "ModelAccess": {
      "description": "What an agent runs as (E): a harness and the account or the provider its model calls use\n(exactly one), and the model. An agent has one (D.1); a session runs with it or another picked\nfor that session (D.19). An agent on the model alone (D.18) has no harness: a provider only\n(AgentSettings checks it).",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "account": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "ModelAccess",
      "type": "object"
    },
    "RequiredHost": {
      "description": "A host a filtered agent reaches whatever its own list says, and why (D.2).",
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        }
      },
      "required": [
        "host",
        "by"
      ],
      "title": "RequiredHost",
      "type": "object"
    }
  },
  "description": "What you work on: a code folder, its caches and skills, and its agents.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "folder": {
      "title": "Folder",
      "type": "string"
    },
    "defaultAgent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Defaultagent"
    },
    "caches": {
      "default": "project",
      "enum": [
        "global",
        "project",
        "off"
      ],
      "title": "Caches",
      "type": "string"
    },
    "area": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area"
    },
    "skills": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "apps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Apps",
      "type": "array"
    },
    "pinned": {
      "title": "Pinned",
      "type": "boolean"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/Agent"
      },
      "title": "Agents",
      "type": "array"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "lastUsedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastusedat"
    }
  },
  "required": [
    "id",
    "name",
    "folder",
    "pinned",
    "agents",
    "createdAt"
  ],
  "title": "Project",
  "type": "object"
}
