          }
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        }
      },
      "title": "AppManifestSuggestedRun",
      "type": "object"
    },
    "AppManifestUi": {
      "additionalProperties": false,
