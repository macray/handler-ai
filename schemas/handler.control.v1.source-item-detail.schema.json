{
  "$id": "urn:handler.control/v1/source-item-detail",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddonPreview": {
      "description": "What installing from `source` would add (G.5), shown before the user decides; `digest`\nnames exactly this content: an install of other content is refused.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "commands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "needs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        },
        "caches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CacheDeclaration"
          },
          "title": "Caches",
          "type": "array"
        },
        "env": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Env",
          "type": "array"
        },
        "settings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AddonSlotInfo"
          },
          "title": "Settings",
          "type": "array"
        },
        "secretSlots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AddonSlotInfo"
          },
          "title": "Secretslots",
          "type": "array"
        },
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "mcp": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "replaces": {
          "anyOf": [
            {
              "enum": [
                "builtin",
                "installed",
                "own"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "toolbox": {
          "$ref": "#/$defs/AddonToolbox",
          "default": {
            "has": [],
            "adds": [],
            "lacking": []
          }
        }
      },
      "required": [
        "source",
        "digest",
        "name"
      ],
      "title": "AddonPreview",
      "type": "object"
    },
    "AddonSlotInfo": {
      "description": "A setting or secret slot of an addon (G.1), for the binding form.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "AddonSlotInfo",
      "type": "object"
    },
    "AddonToolbox": {
      "description": "What an addon needs from the toolbox (B.6), against what the toolbox gives (G.5).",
      "properties": {
        "has": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Has",
          "type": "array"
        },
        "adds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolboxAdd"
          },
          "title": "Adds",
          "type": "array"
        },
        "lacking": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lacking",
          "type": "array"
        }
      },
      "title": "AddonToolbox",
      "type": "object"
    },
    "AgentDefinition": {
      "description": "What an agent set up from it starts with (D.18): everything but what it runs as and where\nit works, its defaults; `skills` come with it, installed in the library when it is set up.\nAn agents file's agents are definitions (D.23), and so are those Handler ships for its needs\n(D.18).",
      "properties": {
        "agentName": {
          "title": "Agentname",
          "type": "string"
        },
        "agentDescription": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agentdescription"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "network": {
          "default": "filtered",
          "enum": [
            "none",
            "filtered",
            "open"
          ],
          "title": "Network",
          "type": "string"
        },
        "egress": {
          "default": "enforce",
          "enum": [
            "enforce",
            "log-only"
          ],
          "title": "Egress",
          "type": "string"
        },
        "allow": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "confinement": {
          "default": "strict",
          "enum": [
            "strict",
            "nested",
            "privileged"
          ],
          "title": "Confinement",
          "type": "string"
        },
        "permissions": {
          "default": "bypass",
          "enum": [
            "ask",
            "accept-edits",
            "bypass"
          ],
          "title": "Permissions",
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentInterface"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "addons": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Addons",
          "type": "array"
        },
        "knowledge": {
          "default": [],
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[^/\\x00]",
            "type": "string"
          },
          "title": "Knowledge",
          "type": "array"
        },
        "schemas": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnowledgeUse"
          },
          "title": "Schemas",
          "type": "array"
        },
        "display": {
          "default": false,
          "title": "Display",
          "type": "boolean"
        },
        "env": {
          "default": {},
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "string"
            }
          },
          "title": "Env",
          "type": "object"
        },
        "modelAlone": {
          "default": false,
          "title": "Modelalone",
          "type": "boolean"
        }
      },
      "required": [
        "agentName"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentInterface": {
      "description": "How a session of an agent starts and ends (D.18): a form (one of its fields may name a\nskill of the library to work on, its subject), and maybe the result its final message holds.\nWith a result, a job: each run is unattended, so in permission mode `bypass` (no one is there\nto answer its requests). Without, a brief: the form starts a session you then work in.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "timeoutSec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 86400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutsec"
        }
      },
      "title": "AgentInterface",
      "type": "object"
    },
    "AgentsFile": {
      "description": "Agents written so they can be set up again in another project (D.23): their definitions\nwithout what is yours (the models they run as, their folder, the connections and notes\nfolders they were given), with what they need instead.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "place": {
          "default": "project",
          "enum": [
            "project",
            "outside"
          ],
          "title": "Place",
          "type": "string"
        },
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentsFileAgent"
          },
          "minItems": 1,
          "title": "Agents",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version",
        "agents"
      ],
      "title": "AgentsFile",
      "type": "object"
    },
    "AgentsFileAgent": {
      "description": "One of an agents file's agents (D.23): its definition and the checks that come with it.",
      "properties": {
        "part": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Part",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/AgentDefinition"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentsFileCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "part",
        "definition"
      ],
      "title": "AgentsFileAgent",
      "type": "object"
    },
    "AgentsFileCheck": {
      "description": "A check that comes with an agents file's agent (D.20, D.23): copied to each agent set\nup.",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "default": {},
          "title": "Input",
          "type": "object"
        },
        "answer": {
          "additionalProperties": true,
          "title": "Answer",
          "type": "object"
        },
        "compare": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Compare",
          "type": "array"
        }
      },
      "required": [
        "name",
        "answer",
        "compare"
      ],
      "title": "AgentsFileCheck",
      "type": "object"
    },
    "AppManifest": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "handler.app/v1",
          "title": "Apiversion",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "changes": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changes"
        },
        "server": {
          "$ref": "#/$defs/AppManifestServer",
          "default": {
            "entry": "server/main.ts"
          }
        },
        "ui": {
          "$ref": "#/$defs/AppManifestUi",
          "default": {
            "dir": "ui/dist"
          }
        },
        "needs": {
          "$ref": "#/$defs/AppManifestNeeds",
          "default": {
            "egress": [],
            "secrets": [],
            "files": {},
            "notify": false
          }
        },
        "routes": {
          "default": {},
          "patternProperties": {
            "^(POST|PUT|PATCH|DELETE) /api/[A-Za-z0-9/_.-]*$": {
              "enum": [
                "sync",
                "queued"
              ],
              "type": "string"
            }
          },
          "title": "Routes",
          "type": "object"
        },
        "automations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AppManifestSuggestedAutomation"
          },
          "maxItems": 5,
          "title": "Automations",
          "type": "array"
        },
        "actions": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestAction"
            }
          },
          "title": "Actions",
          "type": "object"
        },
        "jobs": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestJob"
            }
          },
          "title": "Jobs",
          "type": "object"
        },
        "nudges": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestNudge"
            }
          },
          "title": "Nudges",
          "type": "object"
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resources"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schemas": {
          "default": [],
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Schemas",
          "type": "array"
        }
      },
      "required": [
        "apiVersion",
        "name",
        "version"
      ],
      "title": "AppManifest",
      "type": "object"
    },
    "AppManifestAction": {
      "additionalProperties": false,
      "description": "An action: something the person can ask the app in a sentence (H.12), what Ask's router\nreads, what the app's page lists (with Try). Done by its code (`route`: the backend answers an\nActionResult at once) or by one of its jobs (`job`: a run of it, its form the job's).",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "examples": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Examples",
          "type": "array"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "job": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        }
      },
      "required": [
        "description"
      ],
      "title": "AppManifestAction",
      "type": "object"
    },
    "AppManifestFileNeed": {
      "additionalProperties": false,
      "description": "A folder (or a file) of the person's the backend reads (or writes), H.9: which one is the\nperson's choice at install, mounted at the same path.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "mode": {
          "default": "ro",
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        },
        "init": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Init",
          "type": "array"
        }
      },
      "title": "AppManifestFileNeed",
      "type": "object"
    },
    "AppManifestJob": {
      "additionalProperties": false,
      "description": "A job (H.1): work of the app's that needs a model, run by the Who works the person chose\nfor the app. Its instructions are `jobs/<name>.md` of the app's folder; what it reaches (its\nfolders and their access, its schemas, its hosts) is declared here, said before a deploy that\nadds to it.",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "files": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "enum": [
                "read",
                "write"
              ],
              "type": "string"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "worksIn": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,29}$",
            "type": "string"
          },
          "title": "Worksin",
          "type": "array"
        },
        "schemas": {
          "default": [],
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Schemas",
          "type": "array"
        },
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "timeout": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d{0,3}[mhd]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "then": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Then"
        }
      },
      "required": [
        "description",
        "result"
      ],
      "title": "AppManifestJob",
      "type": "object"
    },
    "AppManifestNeeds": {
      "additionalProperties": false,
      "description": "What the app may reach (H.2). Shown when it is deployed; more than before is flagged.",
      "properties": {
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "files": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestFileNeed"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "notify": {
          "default": false,
          "title": "Notify",
          "type": "boolean"
        }
      },
      "title": "AppManifestNeeds",
      "type": "object"
    },
    "AppManifestNudge": {
      "additionalProperties": false,
      "description": "A nudge (H.17): something the app asks a person to do, under a name that stays the same\nfrom one to the next (`daily-log`). A click opens one of its actions' form (`action`) or a\npage of its UI (`open`): the manifest's, never the call's.",
      "properties": {
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "open": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^/[A-Za-z0-9/_.~%-]*(\\?[A-Za-z0-9=&_.~%-]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open"
        },
