    "CacheDeclaration": {
      "additionalProperties": false,
      "description": "A cache (B.6): the home path it is mounted at, which is what it is whoever declares it;\nwhat it holds, in people's words (shown first): a short name, then after \": \" more if\nneeded (\"Tool caches: uv and pip packages\u2026\"); whether it is a general folder any tool\nwrites to (`~/.cache`) rather than one tool's (`~/.cargo`); its folder of commands, put on\nPATH after the image's (`bin` for `~/.cargo/bin`); its kind: a folder tools read and write\n(most), or a container engine's images (`images`), which a runtime may give as a store of\nthe sandbox's own and the images' downloads shared (contract A.9).",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "about": {
          "maxLength": 200,
          "minLength": 1,
          "title": "About",
          "type": "string"
        },
        "general": {
          "default": false,
          "title": "General",
          "type": "boolean"
        },
        "bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bin"
        },
        "kind": {
          "default": "folder",
          "enum": [
            "folder",
            "images"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "target",
        "about"
      ],
      "title": "CacheDeclaration",
      "type": "object"
    },
    "KnowledgeUse": {
      "description": "A schema an agent reads or writes (D.29): it gets that schema, read-only; its documents\nare in its notes folders. `write`: it may make and change documents of that schema (where:\nits read-write folders, D.5).",
      "properties": {
        "schemaId": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
          "title": "Schemaid",
          "type": "string"
        },
        "access": {
          "default": "read",
          "enum": [
            "read",
            "write"
