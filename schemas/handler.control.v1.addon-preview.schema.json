{
  "$id": "urn:handler.control/v1/addon-preview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddonSlotInfo": {
      "description": "A setting or secret slot of an addon (G.1), for the binding form.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "AddonSlotInfo",
      "type": "object"
    },
    "AddonToolbox": {
      "description": "What an addon needs from the toolbox (B.6), against what the toolbox gives (G.5).",
      "properties": {
        "has": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Has",
          "type": "array"
        },
        "adds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolboxAdd"
          },
          "title": "Adds",
          "type": "array"
        },
        "lacking": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lacking",
          "type": "array"
        }
      },
      "title": "AddonToolbox",
      "type": "object"
    },
    "CacheDeclaration": {
      "additionalProperties": false,
      "description": "A cache (B.6): the home path it is mounted at, which is what it is whoever declares it;\nwhat it holds, in people's words (shown first): a short name, then after \": \" more if\nneeded (\"Tool caches: uv and pip packages\u2026\"); whether it is a general folder any tool\nwrites to (`~/.cache`) rather than one tool's (`~/.cargo`); its folder of commands, put on\nPATH after the image's (`bin` for `~/.cargo/bin`).",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "about": {
          "maxLength": 200,
          "minLength": 1,
          "title": "About",
          "type": "string"
        },
        "general": {
          "default": false,
          "title": "General",
          "type": "boolean"
        },
        "bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bin"
        }
      },
      "required": [
        "target",
        "about"
      ],
      "title": "CacheDeclaration",
      "type": "object"
    },
    "ToolboxAdd": {
      "description": "A system package (B.7) a save or an install adds to the toolbox, for what it needs.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "provides": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provides",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolboxAdd",
      "type": "object"
    }
  },
  "description": "What installing from `source` would add (G.5), shown before the user decides; `digest`\nnames exactly this content: an install of other content is refused.",
  "properties": {
    "source": {
      "title": "Source",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image"
    },
    "commands": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Commands",
      "type": "array"
    },
    "needs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Needs",
      "type": "array"
    },
    "caches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CacheDeclaration"
      },
      "title": "Caches",
      "type": "array"
    },
    "env": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Env",
      "type": "array"
    },
    "settings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AddonSlotInfo"
      },
      "title": "Settings",
      "type": "array"
    },
    "secretSlots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AddonSlotInfo"
      },
      "title": "Secretslots",
      "type": "array"
    },
    "egress": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Egress",
      "type": "array"
    },
    "mcp": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mcp"
    },
    "skills": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "replaces": {
      "anyOf": [
        {
          "enum": [
            "builtin",
            "installed",
            "own"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replaces"
    },
    "toolbox": {
      "$ref": "#/$defs/AddonToolbox",
      "default": {
        "has": [],
        "adds": [],
        "lacking": []
      }
    }
  },
  "required": [
    "source",
    "digest",
    "name"
  ],
  "title": "AddonPreview",
  "type": "object"
}
