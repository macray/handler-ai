{
  "$id": "urn:handler.control/v1/check-run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CheckResult": {
      "description": "One check in a check run (D.20).",
      "properties": {
        "checkId": {
          "title": "Checkid",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "waiting",
            "running",
            "passed",
            "failed",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        },
        "got": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Got"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        }
      },
      "required": [
        "checkId",
        "name",
        "state"
      ],
      "title": "CheckResult",
      "type": "object"
    }
  },
  "description": "An agent's checks run once, one after another (D.20).",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endedat"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "id",
    "startedAt",
    "results"
  ],
  "title": "CheckRun",
  "type": "object"
}
