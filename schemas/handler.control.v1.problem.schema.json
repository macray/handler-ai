{
  "$id": "urn:handler.control/v1/problem",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "RFC 9457 problem details, used for every Control API error.",
  "properties": {
    "type": {
      "default": "about:blank",
      "title": "Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "integer"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "instance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instance"
    },
    "toolboxAdds": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Toolboxadds"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "title": "Problem",
  "type": "object"
}
