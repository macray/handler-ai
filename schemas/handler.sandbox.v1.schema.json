{
  "$id": "urn:handler.sandbox/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FilteredNetwork": {
      "properties": {
        "mode": {
          "const": "filtered",
          "title": "Mode",
          "type": "string"
        },
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "enforcement": {
          "enum": [
            "enforce",
            "log-only"
          ],
          "title": "Enforcement",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "allow",
        "enforcement"
      ],
      "title": "FilteredNetwork",
      "type": "object"
    },
    "GeneratedFile": {
      "description": "File generated by the platform: mounted read-only into the sandbox, or \u2014 with `seed` \u2014\ncopied into a writable path before the process starts, so the harness may rewrite it\n(changes are discarded with the sandbox). A seeded file must lie under a writable path.",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "pattern": "^0?[0-7]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "seed": {
          "default": false,
          "title": "Seed",
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "content"
      ],
      "title": "GeneratedFile",
      "type": "object"
    },
    "ImageMount": {
      "description": "An image's filesystem, mounted read-only (A.1), e.g. an addon (docs/dev/design/addons.md).",
      "properties": {
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "image",
        "target"
      ],
      "title": "ImageMount",
      "type": "object"
    },
    "Injection": {
      "description": "A secret the sandbox's proxy gives, not the sandbox (A.3): the process holds the\n`phantom`; the proxy puts `value` in its place in requests to `hosts`, and refuses a request\nholding it anywhere else. Both have the same length: swapping them (the value in a response\nbecomes the phantom again) keeps every message's length.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "phantom": {
          "minLength": 8,
          "pattern": "^[!-~]+$",
          "title": "Phantom",
          "type": "string"
        },
        "value": {
          "pattern": "^[ -~]+$",
          "title": "Value",
          "type": "string"
        },
        "hosts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Hosts",
          "type": "array"
        }
      },
      "required": [
        "name",
        "phantom",
        "value",
        "hosts"
      ],
      "title": "Injection",
      "type": "object"
    },
    "Mount": {
      "description": "Filesystem mount as seen by the sandbox (A.1). Targets are absolute.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "readOnly": {
          "title": "Readonly",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "scope",
            "state",
            "cache",
            "config",
            "knowledge",
            "app",
            "subject"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "readOnly",
        "kind"
      ],
      "title": "Mount",
      "type": "object"
    },
    "NoNetwork": {
      "properties": {
        "mode": {
          "const": "none",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "NoNetwork",
      "type": "object"
    },
    "OpenNetwork": {
      "properties": {
        "mode": {
          "const": "open",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "OpenNetwork",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "memory": {
          "anyOf": [
            {
              "pattern": "^\\d+[kmgKMG]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "SandboxUser": {
      "properties": {
        "mode": {
          "const": "host-user",
          "title": "Mode",
          "type": "string"
        },
        "home": {
          "title": "Home",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "home"
      ],
      "title": "SandboxUser",
      "type": "object"
    },
    "WaylandDisplay": {
      "description": "A display the sandboxed process may draw on (A.6): only this Wayland socket.",
      "properties": {
        "mode": {
          "const": "wayland",
          "title": "Mode",
          "type": "string"
        },
        "socket": {
          "title": "Socket",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "socket"
      ],
      "title": "WaylandDisplay",
      "type": "object"
    }
  },
  "properties": {
    "apiVersion": {
      "const": "handler.sandbox/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$",
      "title": "Name",
      "type": "string"
    },
    "confinement": {
      "default": "strict",
      "enum": [
        "strict",
        "nested",
        "privileged"
      ],
      "title": "Confinement",
      "type": "string"
    },
    "image": {
      "title": "Image",
      "type": "string"
    },
    "argv": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "env": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "string"
        }
      },
      "title": "Env",
      "type": "object"
    },
    "workdir": {
      "title": "Workdir",
      "type": "string"
    },
    "user": {
      "$ref": "#/$defs/SandboxUser"
    },
    "mounts": {
      "items": {
        "$ref": "#/$defs/Mount"
      },
      "title": "Mounts",
      "type": "array"
    },
    "imageMounts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ImageMount"
      },
      "title": "Imagemounts",
      "type": "array"
    },
    "pathAppend": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Pathappend",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/GeneratedFile"
      },
      "title": "Files",
      "type": "array"
    },
    "writablePaths": {
      "items": {
        "type": "string"
      },
      "title": "Writablepaths",
      "type": "array"
    },
    "network": {
      "discriminator": {
        "mapping": {
          "filtered": "#/$defs/FilteredNetwork",
          "none": "#/$defs/NoNetwork",
          "open": "#/$defs/OpenNetwork"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoNetwork"
        },
        {
          "$ref": "#/$defs/OpenNetwork"
        },
        {
          "$ref": "#/$defs/FilteredNetwork"
        }
      ],
      "title": "Network"
    },
    "resources": {
      "anyOf": [
        {
          "$ref": "#/$defs/Resources"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "display": {
      "anyOf": [
        {
          "$ref": "#/$defs/WaylandDisplay"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "labels": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labels"
    },
    "tty": {
      "default": false,
      "title": "Tty",
      "type": "boolean"
    },
    "injections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Injection"
      },
      "title": "Injections",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "name",
    "image",
    "argv",
    "env",
    "workdir",
    "user",
    "mounts",
    "files",
    "writablePaths",
    "network"
  ],
  "title": "SandboxSpec",
  "type": "object"
}
