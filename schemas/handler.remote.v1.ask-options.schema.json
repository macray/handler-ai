{
  "$id": "urn:handler.remote/v1/ask-options",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActionOption": {
      "description": "One action Ask can pick: which app's, and what it does.",
      "properties": {
        "app": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "App",
          "type": "string"
        },
        "action": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "Action",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "app",
        "action",
        "description"
      ],
      "title": "ActionOption",
      "type": "object"
    }
  },
  "description": "`_handler/remote/ask_options` \u2192 this: the actions Ask can pick now (the owner's devices),\nand whether it can be said (D.25: a speech model chosen) and the answers read aloud.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionOption"
      },
      "title": "Actions",
      "type": "array"
    },
    "listens": {
      "default": false,
      "title": "Listens",
      "type": "boolean"
    },
    "readAloudSpoken": {
      "default": true,
      "title": "Readaloudspoken",
      "type": "boolean"
    },
    "readAloudTyped": {
      "default": false,
      "title": "Readaloudtyped",
      "type": "boolean"
    }
  },
  "required": [
    "actions"
  ],
  "title": "AskOptions",
  "type": "object"
}
