{
  "$id": "urn:handler.control/v1/create-session-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ModelAccess": {
      "description": "What an agent runs as (E): a harness and the account or the provider its model calls use\n(exactly one), and the model. An agent has one or more (D.1); a session runs with one.",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "account": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "ModelAccess",
      "type": "object"
    },
    "SessionInput": {
      "description": "What a run of an agent with an interface is started with (D.18).",
      "properties": {
        "fields": {
          "additionalProperties": true,
          "default": {},
          "title": "Fields",
          "type": "object"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionSubject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SessionInput",
      "type": "object"
    },
    "SessionSubject": {
      "description": "The handler object a run works on (D.18).",
      "properties": {
        "skill": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Skill",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        }
      },
      "required": [
        "skill"
      ],
      "title": "SessionSubject",
      "type": "object"
    }
  },
  "properties": {
    "agentId": {
      "minLength": 1,
      "title": "Agentid",
      "type": "string"
    },
    "acpSessionId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acpsessionid"
    },
    "prompt": {
      "anyOf": [
        {
          "maxLength": 200000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fromSkill": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fromskill"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelAccess"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "origin": {
      "default": "ui",
      "enum": [
        "ui",
        "cli",
        "editor",
        "phone",
        "automation"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "required": [
    "agentId"
  ],
  "title": "CreateSessionRequest",
  "type": "object"
}
