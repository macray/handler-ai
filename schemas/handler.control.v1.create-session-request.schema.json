{
  "$id": "urn:handler.control/v1/create-session-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ModelAccess": {
      "description": "What an agent runs as (E): a harness and the account or the provider its model calls use\n(exactly one), and the model. An agent has one (D.1); a session runs with it or another picked\nfor that session (D.19). An agent on the model alone (D.18) has no harness: a provider only\n(AgentSettings checks it).",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "account": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "ModelAccess",
      "type": "object"
    },
    "SessionAppDraft": {
      "description": "A session working on a draft of an app's code (H.15): its folder, kept by Handler, starts\nas a copy of `app`'s code, or empty for a new app (none). Used (`POST\n/v1/apps/from-draft/{session}`), its code becomes the app's next version, or a new app.",
      "properties": {
        "app": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App"
        }
      },
      "title": "SessionAppDraft",
      "type": "object"
    },
    "SessionInput": {
      "description": "What a session of an agent with an interface is started with (D.18): a job's run, a\nbrief's session.",
      "properties": {
        "fields": {
          "additionalProperties": true,
          "default": {},
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "SessionInput",
      "type": "object"
    }
  },
  "properties": {
    "agentId": {
      "minLength": 1,
      "title": "Agentid",
      "type": "string"
    },
    "acpSessionId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acpsessionid"
    },
    "prompt": {
      "anyOf": [
        {
          "maxLength": 200000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fromSkill": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fromskill"
    },
    "appDraft": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionAppDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelAccess"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "origin": {
      "default": "ui",
      "enum": [
        "ui",
        "cli",
        "editor",
        "phone",
        "automation",
        "app",
        "check",
        "ask"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "required": [
    "agentId"
  ],
  "title": "CreateSessionRequest",
  "type": "object"
}
