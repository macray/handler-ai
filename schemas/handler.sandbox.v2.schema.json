{
  "$id": "urn:handler.sandbox/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Addon": {
      "description": "An addon's tools (G.2): a host folder (its image extracted, A.7 `image extract`),\nread-only at `target`; `path`, its folder of commands, on PATH after the image's and the\ncaches'.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Addon",
      "type": "object"
    },
    "CacheFolder": {
      "description": "A host folder kept between sandboxes, read-write, created if missing; its size and its\nclearing through the `cache` verbs (A.9). `path`, its folder of commands, on PATH after the\nimage's (B.6: `~/.cargo/bin`).",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "CacheFolder",
      "type": "object"
    },
    "File": {
      "description": "A file Handler gives, its content here, in the home: read-only, or `writable` (the program\nrewrites it); either way discarded with the sandbox, nothing goes back.",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "mode": {
          "pattern": "^0?[0-7]{3}$",
          "title": "Mode",
          "type": "string"
        },
        "writable": {
          "default": false,
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "content",
        "mode"
      ],
      "title": "File",
      "type": "object"
    },
    "FilteredNetwork": {
      "description": "Only the allowed hosts, through Handler's filter, which fails closed (A.3); its allow-list,\nkept-blocked list and enforcement changed while it runs, in force when the verb returns\n(A.4).",
      "properties": {
        "mode": {
          "const": "filtered",
          "title": "Mode",
          "type": "string"
        },
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "blocked": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocked",
          "type": "array"
        },
        "enforcement": {
          "enum": [
            "enforce",
            "log-only"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "injections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Injection"
          },
          "title": "Injections",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "allow",
        "enforcement"
      ],
      "title": "FilteredNetwork",
      "type": "object"
    },
    "HandlerTool": {
      "description": "An executable Handler gives, in one of Handler's folders (e.g. `handler-sandbox-env`); in\nHANDLER_BIN, a command (`handler-llm`).",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "target",
        "content"
      ],
      "title": "HandlerTool",
      "type": "object"
    },
    "HostFolder": {
      "description": "A host folder at `target`; what the sandbox writes there (`writable`) is on the host.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "writable": {
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "target",
        "writable"
      ],
      "title": "HostFolder",
      "type": "object"
    },
    "Injection": {
      "description": "A secret the sandbox's proxy gives, not the sandbox (A.3): the process holds the\n`phantom`; the proxy puts `value` in its place in requests to `hosts`, and refuses a request\nholding it anywhere else. Both have the same length: swapping them (the value in a response\nbecomes the phantom again) keeps every message's length.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "phantom": {
          "minLength": 8,
          "pattern": "^[!-~]+$",
          "title": "Phantom",
          "type": "string"
        },
        "value": {
          "pattern": "^[ -~]+$",
          "title": "Value",
          "type": "string"
        },
        "hosts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Hosts",
          "type": "array"
        }
      },
      "required": [
        "name",
        "phantom",
        "value",
        "hosts"
      ],
      "title": "Injection",
      "type": "object"
    },
    "KeptFile": {
      "description": "A host file, read-write, alone in its folder (a runtime may mount that folder): what the\nsandbox writes in place is on the host after. In the home.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "KeptFile",
      "type": "object"
    },
    "NoNetwork": {
      "description": "No route at all, loopback only.",
      "properties": {
        "mode": {
          "const": "none",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "NoNetwork",
      "type": "object"
    },
    "OpenNetwork": {
      "description": "The runtime's network; its secrets (`injections`) given by Handler's filter (A.3).",
      "properties": {
        "mode": {
          "const": "open",
          "title": "Mode",
          "type": "string"
        },
        "injections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Injection"
          },
          "title": "Injections",
          "type": "array"
        }
      },
      "required": [
        "mode"
      ],
      "title": "OpenNetwork",
      "type": "object"
    },
    "Paste": {
      "description": "An image pasted in the terminal reaches the program's clipboard reader (D.16): `xclip -o`\nanswers from this host folder, read-only at PASTE_DIR.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Paste",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "memory": {
          "anyOf": [
            {
              "pattern": "^\\d+[kmgKMG]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "SocketFolder": {
      "description": "Where the sandbox and the host meet through Unix sockets (A.10): `source` on the host,\n`target` in the sandbox, each socket in it named with its direction. `serves`: the sandbox\nlistens at `target/<name>`, the host connects at `source/<name>` (an app's backend). `reaches`:\nthe host listens at `source/<name>`, the sandbox connects at `target/<name>`. Nothing else in\nit is shared: what the sandbox writes there may stay in the sandbox (Apple: in its VM).",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "serves": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$",
            "type": "string"
          },
          "title": "Serves",
          "type": "array"
        },
        "reaches": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$",
            "type": "string"
          },
          "title": "Reaches",
          "type": "array"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "SocketFolder",
      "type": "object"
    },
    "WorkFolder": {
      "description": "The scope: read-write, at the same absolute path (A2); what is written there is the host\nuser's.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "WorkFolder",
      "type": "object"
    }
  },
  "properties": {
    "apiVersion": {
      "const": "handler.sandbox/v2",
      "title": "Apiversion",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$",
      "title": "Name",
      "type": "string"
    },
    "image": {
      "title": "Image",
      "type": "string"
    },
    "argv": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "env": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "string"
        }
      },
      "title": "Env",
      "type": "object"
    },
    "workdir": {
      "title": "Workdir",
      "type": "string"
    },
    "home": {
      "title": "Home",
      "type": "string"
    },
    "isolation": {
      "default": "strict",
      "enum": [
        "strict",
        "nested",
        "privileged"
      ],
      "title": "Isolation",
      "type": "string"
    },
    "resources": {
      "anyOf": [
        {
          "$ref": "#/$defs/Resources"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workFolder": {
      "$ref": "#/$defs/WorkFolder"
    },
    "folders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HostFolder"
      },
      "title": "Folders",
      "type": "array"
    },
    "socketFolders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SocketFolder"
      },
      "title": "Socketfolders",
      "type": "array"
    },
    "caches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CacheFolder"
      },
      "title": "Caches",
      "type": "array"
    },
    "keptFiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeptFile"
      },
      "title": "Keptfiles",
      "type": "array"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/File"
      },
      "title": "Files",
      "type": "array"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HandlerTool"
      },
      "title": "Tools",
      "type": "array"
    },
    "addons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Addon"
      },
      "title": "Addons",
      "type": "array"
    },
    "network": {
      "discriminator": {
        "mapping": {
          "filtered": "#/$defs/FilteredNetwork",
          "none": "#/$defs/NoNetwork",
          "open": "#/$defs/OpenNetwork"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoNetwork"
        },
        {
          "$ref": "#/$defs/OpenNetwork"
        },
        {
          "$ref": "#/$defs/FilteredNetwork"
        }
      ],
      "title": "Network"
    },
    "tty": {
      "default": false,
      "title": "Tty",
      "type": "boolean"
    },
    "display": {
      "default": false,
      "title": "Display",
      "type": "boolean"
    },
    "paste": {
      "anyOf": [
        {
          "$ref": "#/$defs/Paste"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "labels": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labels"
    }
  },
  "required": [
    "apiVersion",
    "name",
    "image",
    "argv",
    "env",
    "workdir",
    "home",
    "workFolder",
    "network"
  ],
  "title": "SandboxSpec",
  "type": "object"
}
