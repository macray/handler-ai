{
  "$id": "urn:handler.control/v1/work-folder-info",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A work folder (D.13) as Settings shows it: as written, where that is, whether it exists,\nand the projects whose folder is inside it.",
  "properties": {
    "root": {
      "title": "Root",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "exists": {
      "title": "Exists",
      "type": "boolean"
    },
    "projects": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Projects",
      "type": "array"
    }
  },
  "required": [
    "root",
    "path",
    "exists"
  ],
  "title": "WorkFolderInfo",
  "type": "object"
}
