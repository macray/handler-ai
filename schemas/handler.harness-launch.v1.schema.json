{
  "$id": "urn:handler.harness-launch/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GeneratedFile": {
      "description": "File generated by the platform: mounted read-only into the sandbox, or \u2014 with `seed` \u2014\ncopied into a writable path before the process starts, so the harness may rewrite it\n(changes are discarded with the sandbox). A seeded file must lie under a writable path.",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "pattern": "^0?[0-7]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "seed": {
          "default": false,
          "title": "Seed",
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "content"
      ],
      "title": "GeneratedFile",
      "type": "object"
    },
    "HttpMcpServer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "http",
            "sse"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NameValue"
          },
          "title": "Headers",
          "type": "array"
        }
      },
      "required": [
        "type",
        "name",
        "url"
      ],
      "title": "HttpMcpServer",
      "type": "object"
    },
    "Mount": {
      "description": "Filesystem mount as seen by the sandbox (A.1). Targets are absolute.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "readOnly": {
          "title": "Readonly",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "scope",
            "state",
            "cache",
            "config",
            "knowledge",
            "app",
            "subject"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "readOnly",
        "kind"
      ],
      "title": "Mount",
      "type": "object"
    },
    "NameValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "NameValue",
      "type": "object"
    },
    "SessionDefaults": {
      "description": "Applied by the control plane to every session: MCP servers added to `session/new`,\n`session/load` and `session/resume` (P8); mode and options right after `session/new` (P7).",
      "properties": {
        "modeId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modeid"
        },
        "configOptions": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configoptions"
        },
        "mcpServers": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StdioMcpServer"
                  },
                  {
                    "$ref": "#/$defs/HttpMcpServer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcpservers"
        }
      },
      "title": "SessionDefaults",
      "type": "object"
    },
    "StdioMcpServer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "env": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NameValue"
          },
          "title": "Env",
          "type": "array"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "StdioMcpServer",
      "type": "object"
    }
  },
  "description": "Output of `render` (B.3): intent only, no sandbox implementation details (B2).",
  "properties": {
    "apiVersion": {
      "const": "handler.harness-launch/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "image": {
      "minLength": 1,
      "title": "Image",
      "type": "string"
    },
    "argv": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "home": {
      "title": "Home",
      "type": "string"
    },
    "env": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "string"
        }
      },
      "title": "Env",
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/GeneratedFile"
      },
      "title": "Files",
      "type": "array"
    },
    "mounts": {
      "items": {
        "$ref": "#/$defs/Mount"
      },
      "title": "Mounts",
      "type": "array"
    },
    "writablePaths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Writablepaths",
      "type": "array"
    },
    "egress": {
      "items": {
        "type": "string"
      },
      "title": "Egress",
      "type": "array"
    },
    "sessionDefaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionDefaults"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "apiVersion",
    "image",
    "argv",
    "home",
    "env",
    "files",
    "mounts",
    "egress"
  ],
  "title": "HarnessLaunch",
  "type": "object"
}
