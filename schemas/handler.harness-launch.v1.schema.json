{
  "$id": "urn:handler.harness-launch/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CacheFolder": {
      "description": "A host folder kept between sandboxes, read-write, created if missing; its size and its\nclearing through the `cache` verbs (A.9). `path`, its folder of commands, on PATH after the\nimage's (B.6: `~/.cargo/bin`).",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "CacheFolder",
      "type": "object"
    },
    "File": {
      "description": "A file Handler gives, its content here, in the home: read-only, or `writable` (the program\nrewrites it); either way discarded with the sandbox, nothing goes back.",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "mode": {
          "pattern": "^0?[0-7]{3}$",
          "title": "Mode",
          "type": "string"
        },
        "writable": {
          "default": false,
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "content",
        "mode"
      ],
      "title": "File",
      "type": "object"
    },
    "HandlerTool": {
      "description": "An executable Handler gives, in one of Handler's folders (e.g. `handler-sandbox-env`); in\nHANDLER_BIN, a command (`handler-llm`).",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "target",
        "content"
      ],
      "title": "HandlerTool",
      "type": "object"
    },
    "HostFolder": {
      "description": "A host folder at `target`; what the sandbox writes there (`writable`) is on the host.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "writable": {
          "title": "Writable",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "target",
        "writable"
      ],
      "title": "HostFolder",
      "type": "object"
    },
    "HttpMcpServer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "http",
            "sse"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NameValue"
          },
          "title": "Headers",
          "type": "array"
        }
      },
      "required": [
        "type",
        "name",
        "url"
      ],
      "title": "HttpMcpServer",
      "type": "object"
    },
    "KeptFile": {
      "description": "A host file, read-write, alone in its folder (a runtime may mount that folder): what the\nsandbox writes in place is on the host after. In the home.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "KeptFile",
      "type": "object"
    },
    "NameValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "NameValue",
      "type": "object"
    },
    "SessionDefaults": {
      "description": "Applied by the control plane to every session: MCP servers added to `session/new`,\n`session/load` and `session/resume` (P8); mode and options right after `session/new` (P7).",
      "properties": {
        "modeId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modeid"
        },
        "configOptions": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configoptions"
        },
        "mcpServers": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StdioMcpServer"
                  },
                  {
                    "$ref": "#/$defs/HttpMcpServer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcpservers"
        }
      },
      "title": "SessionDefaults",
      "type": "object"
    },
    "StdioMcpServer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "env": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NameValue"
          },
          "title": "Env",
          "type": "array"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "StdioMcpServer",
      "type": "object"
    }
  },
  "description": "Output of `render` (B.3): intent only, no sandbox implementation details (B2).",
  "properties": {
    "apiVersion": {
      "const": "handler.harness-launch/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "image": {
      "minLength": 1,
      "title": "Image",
      "type": "string"
    },
    "argv": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "home": {
      "title": "Home",
      "type": "string"
    },
    "env": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "string"
        }
      },
      "title": "Env",
      "type": "object"
    },
    "folders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HostFolder"
      },
      "title": "Folders",
      "type": "array"
    },
    "skills": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HostFolder"
      },
      "title": "Skills",
      "type": "array"
    },
    "caches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CacheFolder"
      },
      "title": "Caches",
      "type": "array"
    },
    "keptFiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeptFile"
      },
      "title": "Keptfiles",
      "type": "array"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/File"
      },
      "title": "Files",
      "type": "array"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HandlerTool"
      },
      "title": "Tools",
      "type": "array"
    },
    "egress": {
      "items": {
        "type": "string"
      },
      "title": "Egress",
      "type": "array"
    },
    "sessionDefaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionDefaults"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "apiVersion",
    "image",
    "argv",
    "home",
    "env",
    "egress"
  ],
  "title": "HarnessLaunch",
  "type": "object"
}
