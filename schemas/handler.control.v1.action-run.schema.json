{
  "$id": "urn:handler.control/v1/action-run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActionResult": {
      "additionalProperties": false,
      "description": "What an action gives (H.12): how it went, one or two sentences readable aloud, and what else\nthe app wants to show. A route answers it; an agent's run gives it from its result (its\n`status` and `summary`, I.3's rule).",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "attention",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "data": {
          "default": null,
          "title": "Data"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "title": "ActionResult",
      "type": "object"
    }
  },
  "description": "An action, done or under way (H.12).",
  "properties": {
    "app": {
      "pattern": "^[a-z][a-z0-9-]{0,29}$",
      "title": "App",
      "type": "string"
    },
    "action": {
      "pattern": "^[a-z][a-z0-9-]{0,29}$",
      "title": "Action",
      "type": "string"
    },
    "state": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runid"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionid"
    }
  },
  "required": [
    "app",
    "action",
    "state"
  ],
  "title": "ActionRun",
  "type": "object"
}
