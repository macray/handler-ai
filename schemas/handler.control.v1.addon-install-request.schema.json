{
  "$id": "urn:handler.control/v1/addon-install-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "source": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "toolboxAdds": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "title": "Toolboxadds",
      "type": "array"
    }
  },
  "required": [
    "source",
    "digest"
  ],
  "title": "AddonInstallRequest",
  "type": "object"
}
