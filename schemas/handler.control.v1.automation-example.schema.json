{
  "$id": "urn:handler.control/v1/automation-example",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An example automation handler ships (I.1), copied by `POST /v1/automations`.",
  "properties": {
    "name": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    }
  },
  "required": [
    "name"
  ],
  "title": "AutomationExample",
  "type": "object"
}
