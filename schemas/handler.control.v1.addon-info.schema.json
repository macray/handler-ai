{
  "$id": "urn:handler.control/v1/addon-info",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddonSlotInfo": {
      "description": "A setting or secret slot of an addon (G.1), for the binding form.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "AddonSlotInfo",
      "type": "object"
    },
    "CacheDeclaration": {
      "additionalProperties": false,
      "description": "A cache (B.6): the home path it is mounted at, which is what it is whoever declares it;\nwhat it holds, in people's words (shown first): a short name, then after \": \" more if\nneeded (\"Tool caches: uv and pip packages\u2026\"); whether it is a general folder any tool\nwrites to (`~/.cache`) rather than one tool's (`~/.cargo`); its folder of commands, put on\nPATH after the image's (`bin` for `~/.cargo/bin`).",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "about": {
          "maxLength": 200,
          "minLength": 1,
          "title": "About",
          "type": "string"
        },
        "general": {
          "default": false,
          "title": "General",
          "type": "boolean"
        },
        "bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bin"
        }
      },
      "required": [
        "target",
        "about"
      ],
      "title": "CacheDeclaration",
      "type": "object"
    }
  },
  "description": "An addon (G.1) and, when it has a tool, its image (G.4).",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "state": {
      "default": "installed",
      "enum": [
        "installed",
        "preparing",
        "ready",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "stateDetail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statedetail"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image"
    },
    "imagePresent": {
      "default": false,
      "title": "Imagepresent",
      "type": "boolean"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "builtAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Builtat"
    },
    "commands": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Commands",
      "type": "array"
    },
    "needs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Needs",
      "type": "array"
    },
    "caches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CacheDeclaration"
      },
      "title": "Caches",
      "type": "array"
    },
    "skills": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "settings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AddonSlotInfo"
      },
      "title": "Settings",
      "type": "array"
    },
    "secretSlots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AddonSlotInfo"
      },
      "title": "Secretslots",
      "type": "array"
    },
    "egress": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Egress",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "directory": {
      "title": "Directory",
      "type": "string"
    },
    "builtin": {
      "default": false,
      "title": "Builtin",
      "type": "boolean"
    },
    "overridesBuiltin": {
      "default": false,
      "title": "Overridesbuiltin",
      "type": "boolean"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "updateAvailable": {
      "default": false,
      "title": "Updateavailable",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "directory"
  ],
  "title": "AddonInfo",
  "type": "object"
}
