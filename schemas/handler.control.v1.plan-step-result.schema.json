{
  "$id": "urn:handler.control/v1/plan-step-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What a step's session ends with, in its `handler-result` block (D.27).",
  "properties": {
    "status": {
      "enum": [
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "status",
    "summary"
  ],
  "title": "PlanStepResult",
  "type": "object"
}
