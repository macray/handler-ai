{
  "$id": "urn:handler.remote/v1/shared-app",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A deployed mini app shared with the device's person (H.8).",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "queued": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Queued",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version"
  ],
  "title": "SharedApp",
  "type": "object"
}
