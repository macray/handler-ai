{
  "$id": "urn:handler.control/v1/app",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AppAction": {
      "description": "One of an app's actions (H.12), as its page and Ask's router see it.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "examples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "by": {
          "enum": [
            "code",
            "job"
          ],
          "title": "By",
          "type": "string"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "inAsk": {
          "default": true,
          "title": "Inask",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "by"
      ],
      "title": "AppAction",
      "type": "object"
    },
    "AppDeployment": {
      "description": "One installed version of an app (H.6).",
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "deployedAt": {
          "format": "date-time",
          "title": "Deployedat",
          "type": "string"
        },
        "needs": {
          "$ref": "#/$defs/AppManifestNeeds"
        }
      },
      "required": [
        "version",
        "deployedAt",
        "needs"
      ],
      "title": "AppDeployment",
      "type": "object"
    },
    "AppFileNeed": {
      "description": "A folder (or a file) an app needs (current or source version, H.2), and the one given.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "mode": {
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "file": {
          "default": false,
          "title": "File",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "mode"
      ],
      "title": "AppFileNeed",
      "type": "object"
    },
    "AppJob": {
      "description": "One of an app's jobs (H.1), as its page shows it: what it does and reaches, who runs it.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "canDo": {
          "$ref": "#/$defs/AppJobCanDo"
        },
        "whoWorks": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhoWorks"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "own": {
          "default": false,
          "title": "Own",
          "type": "boolean"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem"
        }
      },
      "required": [
        "name",
        "description",
        "canDo"
      ],
      "title": "AppJob",
      "type": "object"
    },
    "AppJobCanDo": {
      "description": "What a job reaches (H.1), its declaration's: the folders given to the app's files needs it\nreads or writes, those it works in, its schemas, its hosts.",
      "properties": {
        "files": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "enum": [
                "read",
                "write"
              ],
              "type": "string"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "worksIn": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,29}$",
            "type": "string"
          },
          "title": "Worksin",
          "type": "array"
        },
        "schemas": {
          "default": [],
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
            "type": "string"
          },
          "title": "Schemas",
          "type": "array"
        },
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        }
      },
      "title": "AppJobCanDo",
      "type": "object"
    },
    "AppManifestFileNeed": {
      "additionalProperties": false,
      "description": "A folder (or a file) of the person's the backend reads (or writes), H.9: which one is the\nperson's choice at install, mounted at the same path.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "mode": {
          "default": "ro",
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        },
        "init": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Init",
          "type": "array"
        }
      },
      "title": "AppManifestFileNeed",
      "type": "object"
    },
    "AppManifestNeeds": {
      "additionalProperties": false,
      "description": "What the app may reach (H.2). Shown when it is deployed; more than before is flagged.",
      "properties": {
        "egress": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Egress",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "files": {
          "default": {},
          "maxProperties": 10,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,29}$": {
              "$ref": "#/$defs/AppManifestFileNeed"
            }
          },
          "title": "Files",
          "type": "object"
        },
        "notify": {
          "default": false,
          "title": "Notify",
          "type": "boolean"
        }
      },
      "title": "AppManifestNeeds",
      "type": "object"
    },
    "AppManifestNudgeRemind": {
      "additionalProperties": false,
      "description": "How often an open nudge alerts again, by default (the person tones it per nudge, H.17):\nevery `every`, `times` times after its first alert.",
      "properties": {
        "every": {
          "pattern": "^[1-9]\\d{0,3}[mhd]$",
          "title": "Every",
          "type": "string"
        },
        "times": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Times",
          "type": "integer"
        }
      },
      "required": [
        "every"
      ],
      "title": "AppManifestNudgeRemind",
      "type": "object"
    },
    "AppManifestSuggestedAutomation": {
      "additionalProperties": false,
      "description": "An automation the app suggests (`[[automations]]`, I.1): installed with the app, made and\nturned on at Install unless the person switches it off there (`optional`: off unless they\nswitch it on; the CLI asks for each); later made from the app's page, off; its results open\nthe app.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/Schedule"
        },
        "run": {
          "$ref": "#/$defs/AppManifestSuggestedRun"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "when",
        "run"
      ],
      "title": "AppManifestSuggestedAutomation",
      "type": "object"
    },
    "AppManifestSuggestedRun": {
      "additionalProperties": false,
      "description": "What a suggested automation runs: one of the app's jobs (`job`, with its `input`), or one\nof its routes (`call`, as a person's automation calls it: `run = { app, call }`, I.3).",
      "properties": {
        "job": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job"
        },
        "input": {
          "$ref": "#/$defs/AutomationAgentInput",
          "default": {
            "fields": {}
          }
        },
        "call": {
          "anyOf": [
            {
              "pattern": "^POST /api/[A-Za-z0-9/_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call"
        }
      },
      "title": "AppManifestSuggestedRun",
      "type": "object"
    },
    "AppNudge": {
      "description": "One of an app's nudges (H.17), as its page shows it: what it asks, what a click opens,\nits reminders as the app says them and as you set them.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,29}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "open": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open"
        },
        "remind": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppManifestNudgeRemind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ifIgnored": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ifignored"
        },
        "setting": {
          "default": "default",
          "enum": [
            "default",
            "once",
            "silent"
          ],
          "title": "Setting",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Schedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ownWhen": {
          "anyOf": [
            {
              "$ref": "#/$defs/Schedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nextAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nextat"
        },
        "prepared": {
          "default": false,
          "title": "Prepared",
          "type": "boolean"
        },
        "off": {
          "default": false,
          "title": "Off",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "AppNudge",
      "type": "object"
    },
    "AppOffered": {
      "description": "The version the source an app came from offers, as read last (D.26), while it differs\nfrom its kept code's: Update takes it, then deploys it (H.6).",
      "properties": {
        "source": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "changes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changes"
        },
        "addedNeeds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Addedneeds",
          "type": "array"
        }
      },
      "required": [
        "source",
        "version"
      ],
      "title": "AppOffered",
      "type": "object"
    },
    "AppSecret": {
      "description": "A secret an app declares (current or source version): whether it has a value. The value\nitself never leaves the daemon (H.2).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "set": {
          "title": "Set",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "set"
      ],
      "title": "AppSecret",
      "type": "object"
    },
    "AppSource": {
      "description": "The app's source folder as it is now: what Deploy would install (H.6).",
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "changes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changes"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "addedNeeds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Addedneeds",
          "type": "array"
        },
        "needs": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppManifestNeeds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AppSource",
      "type": "object"
    },
    "AutomationAgentInput": {
      "additionalProperties": false,
      "description": "What the agent's run is started with (D.18 `SessionInput`).",
      "properties": {
        "fields": {
          "additionalProperties": true,
          "default": {},
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "AutomationAgentInput",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "description": "A `when` that is a time (I.2): every N minutes, hours or days, or at a local time of day.",
      "properties": {
        "every": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d{0,3}[mhd]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every"
        },
        "at": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "days": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        }
      },
      "title": "Schedule",
      "type": "object"
    },
    "WhoWorks": {
      "description": "Who runs an app's jobs (H.2): a program (a harness) on an account or a provider, and a\nmodel; no program: the model alone, on a provider (D.18), for a job reaching no folder, tool\nor host. One per app, chosen by the person, and maybe one of a job's own.",
      "properties": {
        "program": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program"
        },
        "account": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "WhoWorks",
      "type": "object"
    }
  },
  "description": "An app (H): its code kept by Handler (H.15), what is installed, its backend's state.",
  "properties": {
    "name": {
      "pattern": "^[a-z][a-z0-9-]{0,29}$",
      "title": "Name",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "current": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppDeployment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppDeployment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/AppSource"
    },
    "offered": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppOffered"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "secrets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppSecret"
      },
      "title": "Secrets",
      "type": "array"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppFileNeed"
      },
      "title": "Files",
      "type": "array"
    },
    "suggests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppManifestSuggestedAutomation"
      },
      "title": "Suggests",
      "type": "array"
    },
    "persons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Persons",
      "type": "array"
    },
    "lastUsedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastusedat"
    },
    "fromSource": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fromsource"
    },
    "actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "nudges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppNudge"
      },
      "title": "Nudges",
      "type": "array"
    },
    "whoWorks": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhoWorks"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "jobs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppJob"
      },
      "title": "Jobs",
      "type": "array"
    }
  },
  "required": [
    "name",
    "url",
    "state",
    "source"
  ],
  "title": "App",
  "type": "object"
}
