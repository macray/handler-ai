{
  "$id": "urn:handler.remote/v1/start-session-params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`_handler/remote/start_session` \u2192 StartedSession: a new session of a `remoteStart` agent,\n`prompt` sent as its first turn, shared with the devices once it runs.",
  "properties": {
    "agentId": {
      "title": "Agentid",
      "type": "string"
    },
    "prompt": {
      "anyOf": [
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt"
    }
  },
  "required": [
    "agentId"
  ],
  "title": "StartSessionParams",
  "type": "object"
}
