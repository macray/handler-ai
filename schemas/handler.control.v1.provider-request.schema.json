{
  "$id": "urn:handler.control/v1/provider-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EnvSecret": {
      "additionalProperties": false,
      "properties": {
        "env": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvSecret",
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "FileSecret": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "FileSecret",
      "type": "object"
    },
    "ProviderModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "contextWindow": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contextwindow"
        },
        "maxOutput": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxoutput"
        },
        "reasoning": {
          "default": false,
          "title": "Reasoning",
          "type": "boolean"
        },
        "images": {
          "default": false,
          "title": "Images",
          "type": "boolean"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "native": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProviderModel",
      "type": "object"
    }
  },
  "description": "Create a provider, or replace one (and rename it). Its key goes to the secret store\n(`providers/<name>/apiKey`); without `key`, the one it has is kept. Without `files`, the\nharnesses' config files it has are kept (a template's are given when it is created).",
  "properties": {
    "name": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "endpoints": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "anthropic",
          "openai-chat",
          "responses"
        ]
      },
      "title": "Endpoints",
      "type": "object"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ProviderModel"
      },
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "key": {
      "anyOf": [
        {
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^[^\\n\\r]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key"
    },
    "removeKey": {
      "default": false,
      "title": "Removekey",
      "type": "boolean"
    },
    "files": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FileSecret"
                },
                {
                  "$ref": "#/$defs/EnvSecret"
                },
                {
                  "$ref": "#/$defs/FileContent"
                }
              ]
            },
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Files"
    },
    "contexts": {
      "default": [],
      "items": {
        "maxLength": 32,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9]([A-Za-z0-9 _-]*[A-Za-z0-9])?$",
        "type": "string"
      },
      "title": "Contexts",
      "type": "array"
    }
  },
  "required": [
    "name",
    "endpoints",
    "models"
  ],
  "title": "ProviderRequest",
  "type": "object"
}
