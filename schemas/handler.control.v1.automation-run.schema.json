{
  "$id": "urn:handler.control/v1/automation-run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AutomationAppended": {
      "properties": {
        "to": {
          "title": "To",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "to",
        "bytes"
      ],
      "title": "AutomationAppended",
      "type": "object"
    },
    "AutomationLlmUsage": {
      "properties": {
        "calls": {
          "default": 0,
          "title": "Calls",
          "type": "integer"
        },
        "inTokens": {
          "default": 0,
          "title": "Intokens",
          "type": "integer"
        },
        "outTokens": {
          "default": 0,
          "title": "Outtokens",
          "type": "integer"
        }
      },
      "title": "AutomationLlmUsage",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "automation": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Automation",
      "type": "string"
    },
    "trial": {
      "default": false,
      "title": "Trial",
      "type": "boolean"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionid"
    },
    "seqFrom": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seqfrom"
    },
    "seqTo": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seqto"
    },
    "slot": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slot"
    },
    "missed": {
      "default": 0,
      "title": "Missed",
      "type": "integer"
    },
    "agentSessionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agentsessionid"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exitcode"
    },
    "ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ms"
    },
    "llm": {
      "$ref": "#/$defs/AutomationLlmUsage",
      "default": {
        "calls": 0,
        "inTokens": 0,
        "outTokens": 0
      }
    },
    "appended": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AutomationAppended"
      },
      "title": "Appended",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endedat"
    }
  },
  "required": [
    "id",
    "automation",
    "state",
    "createdAt"
  ],
  "title": "AutomationRun",
  "type": "object"
}
