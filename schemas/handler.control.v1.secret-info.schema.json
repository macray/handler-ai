{
  "$id": "urn:handler.control/v1/secret-info",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SecretSent": {
      "description": "The latest request a sandbox's proxy gave a secret to (A.3 `injected`).",
      "properties": {
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        }
      },
      "required": [
        "t",
        "host"
      ],
      "title": "SecretSent",
      "type": "object"
    }
  },
  "description": "A secret handler uses (D.14), described: a value in its store, or one an account, a provider\nor a binding references where the person keeps it. The value never leaves the daemon.",
  "properties": {
    "path": {
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
      "title": "Path",
      "type": "string"
    },
    "source": {
      "default": "secret",
      "enum": [
        "secret",
        "env",
        "file",
        "command"
      ],
      "title": "Source",
      "type": "string"
    },
    "hasValue": {
      "default": true,
      "title": "Hasvalue",
      "type": "boolean"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "createdAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Createdat"
    },
    "updatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updatedat"
    },
    "usedBy": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Usedby",
      "type": "array"
    },
    "agents": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Agents",
      "type": "array"
    },
    "hosts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Hosts",
      "type": "array"
    },
    "visible": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visible"
    },
    "lastSent": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecretSent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "path"
  ],
  "title": "SecretInfo",
  "type": "object"
}
