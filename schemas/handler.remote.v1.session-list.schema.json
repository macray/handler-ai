{
  "$id": "urn:handler.remote/v1/session-list",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SessionAsk": {
      "description": "The first permission request a shared session waits on you for (D.7).",
      "properties": {
        "toolCallId": {
          "title": "Toolcallid",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "read",
                "edit",
                "delete",
                "move",
                "search",
                "execute",
                "think",
                "fetch",
                "switch_mode",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "risk": {
          "enum": [
            "safe",
            "risky"
          ],
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "toolCallId",
        "risk"
      ],
      "title": "SessionAsk",
      "type": "object"
    },
    "SharedSession": {
      "description": "A running session shared with devices (F, D.7).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projectid"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "origin": {
          "enum": [
            "ui",
            "cli",
            "editor",
            "phone",
            "automation",
            "app",
            "check",
            "ask",
            "plan"
          ],
          "title": "Origin",
          "type": "string"
        },
        "program": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Program"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "acpSessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acpsessionid"
        },
        "busy": {
          "title": "Busy",
          "type": "boolean"
        },
        "pendingPermissions": {
          "title": "Pendingpermissions",
          "type": "integer"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "last": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last"
        },
        "ask": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionAsk"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "origin",
        "program",
        "scope",
        "busy",
        "pendingPermissions",
        "since"
      ],
      "title": "SharedSession",
      "type": "object"
    }
  },
  "description": "`_handler/remote/list_sessions` \u2192 this; also the params of the notification\n`_handler/remote/sessions_changed` (the new list).",
  "properties": {
    "sessions": {
      "items": {
        "$ref": "#/$defs/SharedSession"
      },
      "title": "Sessions",
      "type": "array"
    }
  },
  "required": [
    "sessions"
  ],
  "title": "SessionList",
  "type": "object"
}
